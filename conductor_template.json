{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.1.0.0",
  "parameters": {
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Name of the Azure region the Conductor node should be deployed to (e.g. eastus)."
      }
    },
    "instanceName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "metadata": {
        "description": "Name of the VM (and prefix for its NIC/NSG/public IP/OS disk). Must be different for node0 and node1."
      }
    },
    "instanceSize": {
      "type": "string",
      "allowedValues": [
        "Standard_D8s_v5",
        "Standard_F8s_v2",
        "Standard_F16s_v2",
        "Standard_F32s_v2"
      ],
      "defaultValue": "Standard_F8s_v2",
      "metadata": {
        "description": "Size of the instance."
      }
    },
    "availabilityZone": {
      "type": "string",
      "defaultValue": "",
      "allowedValues": [
        "",
        "1",
        "2",
        "3"
      ],
      "metadata": {
        "description": "[OPTIONAL] Availability zone for this node. Use a different zone for node0 and node1. Leave empty for regions without zones (and use availabilitySetName instead). Mutually exclusive with availabilitySetName."
      }
    },
    "availabilitySetName": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "[OPTIONAL] Name of an existing Availability Set (in this resource group) the node should be deployed to. Mutually exclusive with availabilityZone."
      }
    },
    "managedIdentity": {
      "type": "string",
      "metadata": {
        "description": "Name of the user assigned managed identity to attach to the node. Requires read access to the VM, NIC and VNet (Microsoft.Compute/virtualMachines/read, Microsoft.Network/networkInterfaces/read, Microsoft.Network/virtualNetworks/read)."
      }
    },
    "managedIdentityResourceGroup": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "[OPTIONAL] Resource group of the managed identity. Defaults to the deployment resource group."
      }
    },
    "virtualNetworkName": {
      "type": "string",
      "metadata": {
        "description": "Name of an existing VNet the node should be deployed to."
      }
    },
    "virtualNetworkResourceGroup": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "[OPTIONAL] Resource group of the VNet. Defaults to the deployment resource group."
      }
    },
    "controlSubnetName": {
      "type": "string",
      "metadata": {
        "description": "Name of an existing subnet in the VNet for the node's control interface. Both HA nodes may share the subnet; the nodes must be able to reach each other."
      }
    },
    "controlPrivateIp": {
      "type": "string",
      "minLength": 7,
      "metadata": {
        "description": "Static private IPv4 address for this node's control interface. Must be a free address in controlSubnetName. Must match 'initializer-overrides.node-ip' in this node's cloud-init."
      }
    },
    "haPeerPrivateIp": {
      "type": "string",
      "minLength": 7,
      "metadata": {
        "description": "Static private IPv4 address of the other conductor node (the HA peer). Used to allow HA peer traffic in this node's NSG."
      }
    },
    "createPublicIp": {
      "type": "bool",
      "defaultValue": false,
      "metadata": {
        "description": "[OPTIONAL] Create and attach a static Standard SKU public IP to the control interface."
      }
    },
    "controlAllowedCidr": {
      "type": "string",
      "minLength": 9,
      "defaultValue": "0.0.0.0/0",
      "metadata": {
        "description": "IP address range of the control interfaces of the Routers to be managed by the Conductor (x.x.x.x/x)."
      }
    },
    "adminAllowedCidr": {
      "type": "string",
      "minLength": 9,
      "defaultValue": "0.0.0.0/0",
      "metadata": {
        "description": "IP address range allowed SSH and HTTPS administrative access (x.x.x.x/x)."
      }
    },
    "adminPublicKeyData": {
      "type": "string",
      "metadata": {
        "description": "SSH public key used to authenticate as 't128'. At least 2048-bit, ssh-rsa format."
      }
    },
    "customData": {
      "type": "secureString",
      "minLength": 1,
      "metadata": {
        "description": "Raw (not base64) cloud-init user data for this node, i.e. the contents of conductor-node0-cloud-init.txt / conductor-node1-cloud-init.txt. Pass with: --parameters customData=@<file>"
      }
    }
  },
  "variables": {
    "vnetResourceGroup": "[if(empty(parameters('virtualNetworkResourceGroup')), resourceGroup().name, parameters('virtualNetworkResourceGroup'))]",
    "managedIdentityGroupName": "[if(empty(parameters('managedIdentityResourceGroup')), resourceGroup().name, parameters('managedIdentityResourceGroup'))]",
    "availabilitySetRef": "[resourceId('Microsoft.Compute/availabilitySets', parameters('availabilitySetName'))]",
    "managementSubnetRef": "[resourceId(variables('vnetResourceGroup'), 'Microsoft.Network/virtualNetworks/subnets', parameters('virtualNetworkName'), parameters('controlSubnetName'))]",
    "managedIdentityRef": "[resourceId(variables('managedIdentityGroupName'), 'Microsoft.ManagedIdentity/userAssignedIdentities', parameters('managedIdentity'))]",
    "mgmtName": "[concat(parameters('instanceName'), '-control')]",
    "publicIpRef": "[resourceId('Microsoft.Network/publicIPAddresses', concat(parameters('instanceName'), '-control'))]",
    "offer": "session-smart-networking-payg",
    "sku": "session-smart-networking-public-gen2-byol"
  },
  "resources": [
    {
      "apiVersion": "2018-02-01",
      "name": "pid-2ccb9bc5-9340-57b7-9859-1bf3f5fbb128",
      "type": "Microsoft.Resources/deployments",
      "properties": {
        "mode": "Incremental",
        "template": {
          "$schema": "https://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
          "contentVersion": "1.0.0.0",
          "resources": []
        }
      }
    },
    {
      "apiVersion": "2019-09-01",
      "type": "Microsoft.Network/networkSecurityGroups",
      "name": "[variables('mgmtName')]",
      "location": "[parameters('location')]",
      "properties": {
        "securityRules": [
          {
            "name": "adminSSH",
            "properties": {
              "description": "Allows SSH",
              "protocol": "Tcp",
              "sourcePortRange": "*",
              "destinationPortRange": "22",
              "sourceAddressPrefix": "[parameters('adminAllowedCidr')]",
              "destinationAddressPrefix": "*",
              "access": "Allow",
              "priority": 100,
              "direction": "Inbound"
            }
          },
          {
            "name": "adminHTTPs",
            "properties": {
              "description": "Allows HTTPs",
              "protocol": "Tcp",
              "sourcePortRange": "*",
              "destinationPortRange": "443",
              "sourceAddressPrefix": "[parameters('adminAllowedCidr')]",
              "destinationAddressPrefix": "*",
              "access": "Allow",
              "priority": 200,
              "direction": "Inbound"
            }
          },
          {
            "name": "control",
            "properties": {
              "description": "Allows control connections from Routers",
              "protocol": "Tcp",
              "sourcePortRange": "*",
              "destinationPortRange": "930",
              "sourceAddressPrefix": "[parameters('controlAllowedCidr')]",
              "destinationAddressPrefix": "*",
              "access": "Allow",
              "priority": 300,
              "direction": "Inbound"
            }
          },
          {
            "name": "secureConductorOnboarding",
            "properties": {
              "description": "Allows secure conductor onboarding connections from Routers",
              "protocol": "Tcp",
              "sourcePortRange": "*",
              "destinationPortRange": "933",
              "sourceAddressPrefix": "[parameters('controlAllowedCidr')]",
              "destinationAddressPrefix": "*",
              "access": "Allow",
              "priority": 400,
              "direction": "Inbound"
            }
          },
          {
            "name": "automatedProvisioner",
            "properties": {
              "description": "Allows automatedProvisioner connections from Routers",
              "protocol": "Tcp",
              "sourcePortRange": "*",
              "destinationPortRange": "4505-4506",
              "sourceAddressPrefix": "[parameters('controlAllowedCidr')]",
              "destinationAddressPrefix": "*",
              "access": "Allow",
              "priority": 500,
              "direction": "Inbound"
            }
          },
          {
            "name": "haPeer",
            "properties": {
              "description": "Allows all traffic from the HA peer conductor node (HA sync, SSH key exchange, salt)",
              "protocol": "*",
              "sourcePortRange": "*",
              "destinationPortRange": "*",
              "sourceAddressPrefix": "[concat(parameters('haPeerPrivateIp'), '/32')]",
              "destinationAddressPrefix": "*",
              "access": "Allow",
              "priority": 600,
              "direction": "Inbound"
            }
          }
        ]
      }
    },
    {
      "condition": "[parameters('createPublicIp')]",
      "apiVersion": "2019-09-01",
      "type": "Microsoft.Network/publicIPAddresses",
      "name": "[variables('mgmtName')]",
      "location": "[parameters('location')]",
      "zones": "[if(empty(parameters('availabilityZone')), json('null'), createArray(parameters('availabilityZone')))]",
      "sku": {
        "name": "Standard"
      },
      "properties": {
        "publicIPAllocationMethod": "Static"
      }
    },
    {
      "apiVersion": "2019-09-01",
      "type": "Microsoft.Network/networkInterfaces",
      "name": "[variables('mgmtName')]",
      "location": "[parameters('location')]",
      "dependsOn": [
        "[resourceId('Microsoft.Network/networkSecurityGroups/', variables('mgmtName'))]",
        "[variables('publicIpRef')]"
      ],
      "tags": {
        "SSR-ROLE": "MGMT"
      },
      "properties": {
        "enableAcceleratedNetworking": true,
        "enableIPForwarding": true,
        "networkSecurityGroup": {
          "id": "[resourceId('Microsoft.Network/networkSecurityGroups', variables('mgmtName'))]"
        },
        "ipConfigurations": [
          {
            "name": "[variables('mgmtName')]",
            "properties": {
              "privateIPAllocationMethod": "Static",
              "privateIPAddress": "[parameters('controlPrivateIp')]",
              "publicIPAddress": "[if(parameters('createPublicIp'), createObject('id', variables('publicIpRef')), json('null'))]",
              "subnet": {
                "id": "[variables('managementSubnetRef')]"
              }
            }
          }
        ]
      }
    },
    {
      "apiVersion": "2024-11-01",
      "type": "Microsoft.Compute/virtualMachines",
      "name": "[parameters('instanceName')]",
      "location": "[parameters('location')]",
      "zones": "[if(empty(parameters('availabilityZone')), json('null'), createArray(parameters('availabilityZone')))]",
      "identity": {
        "type": "UserAssigned",
        "userAssignedIdentities": {
          "[variables('managedIdentityRef')]": {}
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.Network/networkInterfaces/', variables('mgmtName'))]"
      ],
      "properties": {
        "hardwareProfile": {
          "vmSize": "[parameters('instanceSize')]"
        },
        "securityProfile": {
          "securityType": "TrustedLaunch",
          "uefiSettings": {
            "secureBootEnabled": false,
            "vTpmEnabled": true
          }
        },
        "osProfile": {
          "computerName": "[parameters('instanceName')]",
          "adminUsername": "t128",
          "linuxConfiguration": {
            "disablePasswordAuthentication": true,
            "ssh": {
              "publicKeys": [
                {
                  "path": "/home/t128/.ssh/authorized_keys",
                  "keyData": "[parameters('adminPublicKeyData')]"
                }
              ]
            }
          },
          "customData": "[base64(parameters('customData'))]"
        },
        "storageProfile": {
          "imageReference": {
            "publisher": "juniper-networks",
            "offer": "[variables('offer')]",
            "sku": "[variables('sku')]",
            "version": "latest"
          },
          "osDisk": {
            "name": "[parameters('instanceName')]",
            "createOption": "FromImage",
            "diskSizeGB": 60
          }
        },
        "availabilitySet": "[if(empty(parameters('availabilitySetName')), json('null'), createObject('id', variables('availabilitySetRef')))]",
        "networkProfile": {
          "networkInterfaces": [
            {
              "id": "[resourceId('Microsoft.Network/networkInterfaces', variables('mgmtName'))]",
              "properties": {
                "primary": true
              }
            }
          ]
        }
      },
      "plan": {
        "name": "[variables('sku')]",
        "publisher": "juniper-networks",
        "product": "[variables('offer')]"
      }
    },
    {
      "name": "[concat(parameters('instanceName'), '/add-admin-user-to-wheels-group')]",
      "type": "Microsoft.Compute/virtualMachines/extensions",
      "location": "[parameters('location')]",
      "apiVersion": "2019-03-01",
      "dependsOn": [
        "[resourceId('Microsoft.Compute/virtualMachines', parameters('instanceName'))]"
      ],
      "properties": {
        "publisher": "Microsoft.Azure.Extensions",
        "type": "CustomScript",
        "typeHandlerVersion": "2.1",
        "autoUpgradeMinorVersion": true,
        "settings": {},
        "protectedSettings": {
          "commandToExecute": "usermod -a -G wheel t128"
        }
      }
    }
  ],
  "outputs": {
    "instanceIPAddress": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Network/networkInterfaces/', variables('mgmtName'))).ipConfigurations[0].properties.privateIPAddress]"
    },
    "publicIPAddress": {
      "condition": "[parameters('createPublicIp')]",
      "type": "string",
      "value": "[reference(variables('publicIpRef')).ipAddress]"
    },
    "SSHLogin": {
      "type": "string",
      "value": "[concat('ssh -i <ssh-key.pem> t128@', if(parameters('createPublicIp'), reference(variables('publicIpRef')).ipAddress, reference(resourceId('Microsoft.Network/networkInterfaces/', variables('mgmtName'))).ipConfigurations[0].properties.privateIPAddress))]"
    }
  }
}
